{
  "manifest_version": 3,
  "name": "Binder Price Helper (TCGplayer)",
  "version": "1.0.0",
  "description": "Personal-use helper: reads TCGplayer market prices and sends them to your local MTG/Lorcana Binder app.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://www.tcgplayer.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Binder Price Helper" }
}
