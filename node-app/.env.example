# Copy this file to ".env" and fill in your Google OAuth credentials.
# (The app runs without these, but Google Drive sync stays disabled.)

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must EXACTLY match the redirect URI you add in Google Cloud Console:
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Any random string — used to sign local sessions.
SESSION_SECRET=please-change-this-to-something-random

PORT=3000

# ---- Live prices (eBay) -------------------------------------------------
# Preferred: app client-credentials (the server mints + refreshes tokens itself).
EBAY_CLIENT_ID=your-ebay-app-client-id
EBAY_CLIENT_SECRET=your-ebay-app-client-secret
# OR, if you already have a short-lived OAuth token, paste it here instead and
# leave the CLIENT_ID/SECRET blank (note: these expire ~2h):
# EBAY_TOKEN=v^1.1#...
EBAY_MARKETPLACE=EBAY_US
# EBAY_ENV=sandbox   # uncomment to hit eBay's sandbox (TEST data only — not real prices)
# TCGplayer has no usable public API — its prices come from the Chrome extension.

# ---- AI listing filter (optional, picks the right listings smartly) -----
# Set ONE provider's key. Auto-detected, or force with AI_PROVIDER.
# AI_PROVIDER=openai          # openai | anthropic  (optional; auto-detected)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=gpt-4o-mini        # optional override (default: gpt-4o-mini / claude-haiku-4-5-20251001)
#
# You can also paste these into the Chrome extension's "API keys" panel instead
# of editing this file — they'll be saved to .data/secrets.json on this machine.

# ---- Deployment (only needed if you host this publicly) ----------------
# A deployed app is reachable by anyone with the URL, so set a password.
# The browser will prompt for it (any username, this password).
APP_PASSWORD=
# After connecting Drive once, the server logs a refresh token — set it here so
# a redeploy on an ephemeral-disk host doesn't log you out. (Not needed for Gist.)
GOOGLE_REFRESH_TOKEN=
